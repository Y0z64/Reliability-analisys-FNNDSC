# NOTE: data/ and the CSVs + PDFs in assets/ ARE tracked on purpose. The CSVs in
# data/ are the inputs to every analysis notebook, and two of them (subject.csv,
# raw_subject_data.csv) are hand-curated and cannot be regenerated.

# Generated figures. Every one is regenerated by a notebook -- see
# docs/pipeline.md for which. assets/artifacts/.gitkeep keeps the directory
# present in a fresh clone, since some notebooks savefig into it without mkdir.
*.png

# Generated per-subject reports (papermill notebooks + PDFs).
# Regenerate with src/reliability/batch_process.py
reports/
outputs/

# Jupyter
.ipynb_checkpoints/
.jupyter/
.jupyter_ystore.db

# Python
__pycache__/
*.py[oc]
.ruff_cache/
build/
dist/
wheels/
*.egg-info
.venv
venv

# Editors
.vscode/
*.vscode

# Scratch
tempscript*
subjects_batched/

# Volumetric data and surfaces live on the cluster, never in the repo
*.nii
*.nii.gz
*.obj
*.gii
